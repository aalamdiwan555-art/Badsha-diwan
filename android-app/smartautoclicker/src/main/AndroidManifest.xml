<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to start the SmartAutoClickerService as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Needed to use the media projection with SmartAutoClickerService. Starting with SDK 34 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!-- Needed to display the overlay_menu over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Needed to keep the screen active while detecting, only if defined by the user. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name="${smartAutoClickerApplication}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_smart_auto_clicker"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_smart_auto_clicker_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="DataExtractionRules">

        <activity
            android:name="com.buzbuz.smartautoclicker.scenarios.ScenarioActivity"
            android:exported="false" />

        <activity
            android:name="com.autopilot.driver.auth.AutopilotWelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.autopilot.driver.auth.ModeSelectionActivity"
            android:exported="false" />

        <activity
            android:name="com.autopilot.driver.home.AutopilotHomeActivity"
            android:exported="false" />

        <activity
            android:name="com.autopilot.driver.home.ProfileActivity"
            android:exported="false" />

        <activity
            android:name="com.autopilot.driver.home.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name="com.buzbuz.smartautoclicker.settings.SettingsActivity"
            android:exported="false" />

        <service
            android:name="com.buzbuz.smartautoclicker.SmartAutoClickerService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:foregroundServiceType="mediaProjection"
            android:exported="true">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibilityservice" />
        </service>

        <service
            android:name="com.autopilot.driver.service.AutopilotFloatingBannerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_ui_overlay" />
        </service>

        <service
            android:name="com.autopilot.driver.service.AutopilotFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>