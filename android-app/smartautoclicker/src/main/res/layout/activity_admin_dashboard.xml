<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_title"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/admin_mode_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#00F0FF"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/admin_mode_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/admin_mode_name_hint"
            android:inputType="textCapSentences"
            android:textColor="@android:color/white"
            android:textColorHint="#91A0B5" />

        <EditText
            android:id="@+id/admin_mode_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/admin_mode_description_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:textColor="@android:color/white"
            android:textColorHint="#91A0B5" />

        <Button
            android:id="@+id/admin_create_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/admin_create_mode" />

        <LinearLayout
            android:id="@+id/admin_mode_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/admin_settings_title"
            android:textColor="#00F0FF"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/admin_interstitial_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_interstitial_interval_hint"
            android:inputType="number"
            android:textColor="@android:color/white"
            android:textColorHint="#91A0B5" />

        <EditText
            android:id="@+id/admin_reward_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_reward_ads_hint"
            android:inputType="number"
            android:textColor="@android:color/white"
            android:textColorHint="#91A0B5" />

        <EditText
            android:id="@+id/admin_trial_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_trial_days_hint"
            android:inputType="number"
            android:textColor="@android:color/white"
            android:textColorHint="#91A0B5" />

        <Button
            android:id="@+id/admin_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/admin_save_settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/admin_users_title"
            android:textColor="#00F0FF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/admin_user_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/admin_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#B8C5D6"
            android:textSize="14sp" />

        <Button
            android:id="@+id/admin_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/admin_refresh" />

        <Button
            android:id="@+id/admin_logout"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/profile_logout"
            android:textColor="#B829F7" />
    </LinearLayout>
</ScrollView>